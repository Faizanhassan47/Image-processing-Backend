# ==============================================================================
# Enterprise Digital Pathology System - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and update the values appropriately for your environment.
# Never commit the actual '.env' file or production secrets to source control.

# --- Application Server ---
APP_NAME=Enterprise Digital Pathology API
APP_HOST=127.0.0.1
APP_PORT=8000
ENVIRONMENT=development  # development | staging | production

# --- SQL Server Database Connection ---
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=DigitalPathologyDB
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECTION_TIMEOUT=30

# SQL Server Authentication (required if DB_TRUSTED_CONNECTION=false)
DB_USERNAME=pathology_app_user
DB_PASSWORD=ChangeThisToAStrongDbPassword123!

# --- Security & JWT Authentication ---
# Generate a cryptographically secure random secret using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_64_character_hex_or_base64_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120  # Recommended default: 120 minutes (2 hours)
PASSWORD_MIN_LENGTH=8           # Minimum required password length (recommended: 8 or 12)
REQUIRE_PASSWORD_COMPLEXITY=true

# --- Cookie Security Defaults ---
COOKIE_SECURE=false             # Set to true in staging/production with HTTPS
COOKIE_SAMESITE=lax             # lax | strict | none
COOKIE_HTTPONLY=true

# --- CORS & Client Access ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# --- File Storage & Uploads ---
UPLOADS_DIR=uploads
DOCUMENTS_DIR=uploads/documents
RASTER_MAX_UPLOAD_MB=10
WSI_MAX_UPLOAD_MB=2048
UPLOAD_CHUNK_MB=8
OPENSLIDE_CACHE_SIZE=4
TILE_SIZE=254
TILE_OVERLAP=1

# Optional: Path to OpenSlide native binaries if not in system PATH
# OPENSLIDE_PATH=C:\path\to\openslide\bin

# --- Patient Data Governance & Retention ---
DATA_RETENTION_YEARS=7          # Standard medical record retention period
ARCHIVAL_STORAGE_DIR=archival
LEGAL_HOLD_ENFORCEMENT=true

# --- Malware Scanning & Quarantine ---
ENABLE_MALWARE_SCANNING=true
VIRUS_SCANNER_TYPE=clamav       # clamav | mock | virustotal
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
QUARANTINE_DIR=uploads/quarantine
AUTO_QUARANTINE_ON_SUSPICIOUS=true
