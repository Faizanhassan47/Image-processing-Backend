APP_NAME=Pathology Demo API
APP_HOST=127.0.0.1
APP_PORT=8000

# SQL Server database
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=Pathology
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECTION_TIMEOUT=30
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=12
COOKIE_SECURE=false
CSRF_PROTECTION_ENABLED=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS

UPLOADS_DIR=uploads
QUARANTINE_DIR=quarantine
WATCHED_FOLDER=
RASTER_MAX_UPLOAD_MB=10
WSI_MAX_UPLOAD_MB=2048
UPLOAD_CHUNK_MB=8
OPENSLIDE_CACHE_SIZE=4
TILE_SIZE=254
TILE_OVERLAP=1

LOG_LEVEL=INFO
BACKUP_DIR=backups
RETENTION_DAYS=3650
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=90

# Optional Windows OpenSlide location
# OPENSLIDE_PATH=C:\path\to\openslide\bin

# HoVer-Net AI Inference Configuration
HOVERNET_PYTHON=E:\digital-pathology\ai\hover_net\hovernet_env\Scripts\python.exe
HOVERNET_WORKER=E:\digital-pathology\ai\hovernet_worker.py
HOVERNET_WORKDIR=E:\digital-pathology\ai\hover_net
AI_STORAGE_DIR=storage/ai
