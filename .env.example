# Copy to .env for local development. Never commit real credentials.
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=Hello
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECTION_TIMEOUT=30
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Payment remains fail-closed until an audited provider adapter is installed.
AI_PAYMENT_PROVIDER=disabled
AI_PAYMENT_WEBHOOK_SECRET=
AI_PAYMENT_MERCHANT_ID=
AI_PAYMENT_API_KEY=
